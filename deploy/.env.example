# Bongsu Deployment Configuration
# Copy this file to .env and fill in the values

# === Required ===
# Admin key for web/admin API.
BONGSU_API_KEY=change-me-to-a-strong-random-string
# Agent ingest key for report upload and force-scan polling.
BONGSU_AGENT_API_KEY=change-me-to-a-different-agent-string
# Optional token required for /api/install.sh and binary downloads.
BONGSU_INSTALL_TOKEN=change-me-to-an-install-token
# Optional comma-separated viewer keys mapped to RBAC subjects.
# Example: viewer-secret:alice,team-secret:devops
BONGSU_VIEWER_API_KEYS=

# === Server ===
BONGSU_VERSION=0.1.0
BONGSU_PORT=8080

# === Web UI Auth ===
# true  = API key required to access web UI (default, recommended for public networks)
# false = No login required (for private/trusted networks)
BONGSU_WEB_AUTH=false

# === Database ===
BONGSU_DB_USER=bongsu
BONGSU_DB_PASSWORD=change-me-to-a-secure-password
BONGSU_DB_NAME=bongsu

# === Trivy ===
# trivy-db is managed via docker-compose init container.
# Update command:
#   docker compose run --rm trivy-db sh -c "rm -rf /cache/db/* && trivy image --download-db-only --cache-dir /cache"
#   docker compose restart server
#
# Periodic auto-update (connected environments only):
#   0   = disabled (default, use init container or manual update)
#   6   = every 6 hours
BONGSU_TRIVY_DB_INTERVAL_HOURS=0
BONGSU_TRIVY_DB_REPO=ghcr.io/aquasecurity/trivy-db

# === Security DB aggregation ===
# Connected environments can periodically download OSV/NVD/Trivy metadata,
# import it into PostgreSQL, and later export it for air-gapped installs.
# Example:
# BONGSU_SECURITY_DB_SYNC_CMD=/app/scripts/sync-all-cvedb.sh http://localhost:8080 ${BONGSU_API_KEY}
BONGSU_SECURITY_DB_INTERVAL_HOURS=6
BONGSU_SECURITY_DB_SYNC_CMD=
BONGSU_AUTO_RESCAN_ON_DB_UPDATE=true
BONGSU_AUTO_RESCAN_LAST_SEEN_HOURS=720
BONGSU_VULN_EXPORT_MAX_ROWS=100000
BONGSU_WEBHOOK_URL=
BONGSU_WEBHOOK_SECRET=
BONGSU_WEBHOOK_MIN_SEVERITY=HIGH

# === Agent (for install-agent.sh) ===
BONGSU_SERVER_URL=http://your-server:8080
BONGSU_WORK_DIR=/opt/bongsu
BONGSU_PACKAGES_ONLY=true
BONGSU_CRON=0 3 * * *
BONGSU_INSTALL_MODE=cron
BONGSU_FORCE_SCAN_DAEMON=true
