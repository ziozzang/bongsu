# Bongsu Deployment Configuration
# Copy this file to .env and fill in the values

# === Required ===
# Admin key for web/admin API.
BONGSU_API_KEY=change-me-to-a-strong-random-string
# Agent ingest key for report upload and force-scan polling.
BONGSU_AGENT_API_KEY=change-me-to-a-different-agent-string
# Install/download token required for /api/install.sh and binary downloads.
BONGSU_INSTALL_TOKEN=change-me-to-an-install-token
# Optional comma-separated viewer keys mapped to RBAC subjects.
# Example: viewer-secret:alice,team-secret:devops
BONGSU_VIEWER_API_KEYS=

# === Server ===
BONGSU_VERSION=0.1.0
BONGSU_API_PORT=5677
BONGSU_WEB_PORT=5678

# === Web UI Auth ===
# true  = API key required to access web UI (default, recommended)
# false = No login required (private lab networks only)
BONGSU_WEB_AUTH=true
# Send Strict-Transport-Security on HTTPS or X-Forwarded-Proto=https responses.
BONGSU_HSTS_ENABLED=true
# Development-only escape hatch for placeholder/short/duplicate secrets.
BONGSU_ALLOW_WEAK_SECRETS=false
BONGSU_AGENT_HOST_BINDING=true
BONGSU_ACCESS_LOG=true
BONGSU_ACCESS_LOG_HEALTH=false
BONGSU_HTTP_READ_HEADER_TIMEOUT_SECONDS=10
BONGSU_HTTP_READ_TIMEOUT_SECONDS=30
BONGSU_HTTP_WRITE_TIMEOUT_SECONDS=120
BONGSU_HTTP_IDLE_TIMEOUT_SECONDS=120
BONGSU_HTTP_MAX_HEADER_BYTES=1048576

# === Database ===
BONGSU_DB_USER=bongsu
BONGSU_DB_PASSWORD=change-me-to-a-secure-password
BONGSU_DB_NAME=bongsu
BONGSU_DB_MAX_OPEN_CONNS=25
BONGSU_DB_MAX_IDLE_CONNS=5
BONGSU_DB_CONN_MAX_LIFETIME_MINUTES=5

# === Trivy ===
# trivy-db is managed via docker-compose init container and periodic server refresh.
# Update command:
#   docker compose run --rm trivy-db sh -c "rm -rf /cache/db/* && trivy image --download-db-only --cache-dir /cache"
#   docker compose restart server
#
# Periodic auto-update (connected environments):
#   0   = disabled (use init container or manual update only)
#   6   = every 6 hours
BONGSU_TRIVY_DB_INTERVAL_HOURS=6
BONGSU_TRIVY_DB_REPO=ghcr.io/aquasecurity/trivy-db

# === Security DB aggregation ===
# Connected environments can periodically download OSV/NVD/Trivy metadata,
# import it into PostgreSQL, and later export it for air-gapped installs.
BONGSU_SECURITY_DB_INTERVAL_HOURS=6
BONGSU_SECURITY_DB_SYNC_ON_START=true
BONGSU_SECURITY_DB_SYNC_CMD=/app/scripts/sync-all-cvedb.sh http://localhost:5677
BONGSU_SECURITY_DB_SYNC_OUTPUT_MAX_BYTES=8192
BONGSU_SYNC_REQUIRE_TRIVY_SOURCE=true
BONGSU_SECURITY_DB_REQUIRED_SOURCES=cisa-kev,epss,osv,nvd,trivy
BONGSU_SECURITY_DB_MAX_SOURCE_AGE_HOURS=30
BONGSU_AUTO_RESCAN_ON_DB_UPDATE=true
BONGSU_AUTO_RESCAN_LAST_SEEN_HOURS=720
BONGSU_CVE_MATCH_SOURCES=
BONGSU_CVE_MATCH_MIN_SOURCE_MATCHABLE_PERCENT=0
BONGSU_CVE_MATCH_CANDIDATE_LIMIT=50000
BONGSU_CVE_STATS_CACHE_SECONDS=15
BONGSU_CVE_GROUP_SUMMARY_TIMEOUT_MS=1500
BONGSU_CVE_AFFECTED_INDEX_TIMEOUT_SECONDS=5
BONGSU_CVE_AFFECTED_INDEX_REBUILD_TIMEOUT_SECONDS=180
BONGSU_CVE_REFERENCE_INDEX_TIMEOUT_SECONDS=5
BONGSU_HEALTH_DB_TIMEOUT_SECONDS=2
BONGSU_STARTUP_RECALC_TIMEOUT_SECONDS=120
BONGSU_STALE_REMATCH_CLEANUP_BATCH_SIZE=10000
BONGSU_AGENT_REPORT_MAX_BYTES=536870912
BONGSU_TRIVY_DB_UPLOAD_MAX_BYTES=2147483648
BONGSU_CVE_DB_IMPORT_MAX_BYTES=2147483648
BONGSU_SECURITY_DB_BUNDLE_MAX_BYTES=4294967296
BONGSU_MULTIPART_MEMORY_MAX_BYTES=33554432
BONGSU_JSON_BODY_MAX_BYTES=1048576
BONGSU_API_MAX_PAGE_LIMIT=1000
BONGSU_API_MAX_PAGE_OFFSET=1000000
BONGSU_VULN_EXPORT_MAX_ROWS=100000
BONGSU_WEBHOOK_URL=
BONGSU_WEBHOOK_SECRET=
BONGSU_WEBHOOK_MIN_SEVERITY=HIGH
BONGSU_WEBHOOK_MIN_RISK_LEVEL=high
BONGSU_WEBHOOK_INVENTORY_STATUSES=empty
BONGSU_WEBHOOK_RETRY_ATTEMPTS=3
BONGSU_WEBHOOK_RETRY_DELAY_MS=1000
BONGSU_WEBHOOK_TIMEOUT_SECONDS=15
BONGSU_SLA_CRITICAL_DAYS=7
BONGSU_SLA_HIGH_DAYS=30
BONGSU_SLA_MEDIUM_DAYS=90
BONGSU_SLA_LOW_DAYS=180
BONGSU_TRIAGE_EXPIRING_SOON_DAYS=14
BONGSU_AGENT_ONLINE_MINUTES=1560
BONGSU_AGENT_OFFLINE_MINUTES=4320
BONGSU_INVENTORY_STALE_HOURS=48
BONGSU_RETENTION_SCAN_DAYS=180
BONGSU_RETENTION_SCAN_REQUEST_DAYS=90
BONGSU_RETENTION_AUDIT_DAYS=365
BONGSU_SCAN_REQUEST_CLAIM_TIMEOUT_MINUTES=60

# === Agent (for install-agent.sh) ===
BONGSU_SERVER_URL=http://your-server:5677
BONGSU_WORK_DIR=/opt/bongsu
BONGSU_PACKAGES_ONLY=true
BONGSU_CRON=0 3 * * *
BONGSU_INSTALL_MODE=cron
BONGSU_FORCE_SCAN_DAEMON=true
