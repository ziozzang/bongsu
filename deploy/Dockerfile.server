ARG BONGSU_VERSION=0.2.0

# ---- Frontend ----
FROM node:22-alpine AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ---- Backend ----
FROM golang:1.25-alpine AS backend
ARG BONGSU_VERSION
ARG BONGSU_COMMIT=unknown
ARG BONGSU_BUILD_DATE=unknown
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /build/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${BONGSU_VERSION} -X main.commit=${BONGSU_COMMIT} -X main.buildDate=${BONGSU_BUILD_DATE}" -o bongsu-server ./cmd/server
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${BONGSU_VERSION} -X main.commit=${BONGSU_COMMIT} -X main.buildDate=${BONGSU_BUILD_DATE}" -o bongsu-agent ./cmd/agent

# ---- Runtime ----
FROM alpine:3.20
# bash/curl/python3/unzip back the security-DB sync scripts (scripts/sync-all-cvedb.sh).
RUN apk --no-cache add ca-certificates tzdata bash curl python3 unzip

# Trivy is bundled in the SERVER image because it feeds the optional "trivy" CVE
# source (BONGSU_SECURITY_DB_REQUIRED_SOURCES) and the trivy-db init container reuses
# this same image to download the Trivy vulnerability DB. The agent's native scanner
# does NOT need it. Pin/override with --build-arg TRIVY_VERSION=...
ARG TRIVY_VERSION=0.70.0
RUN curl -sL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" | \
    tar -xzf - -C /usr/local/bin trivy

RUN addgroup -g 1000 -S bongsu && \
    adduser -u 1000 -S bongsu -G bongsu -H -D

COPY --from=backend /build/bongsu-server /usr/local/bin/bongsu-server
COPY --from=backend /build/bongsu-agent /app/bin/bongsu-agent
COPY --from=backend /build/migrations /app/migrations
COPY --from=backend /build/scripts /app/scripts
COPY --from=frontend /build/web/dist /app/web/dist

RUN mkdir -p /app/trivy-cache && chown -R bongsu:bongsu /app

ENV BONGSU_TRIVY_CACHE_DIR=/app/trivy-cache

USER bongsu

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=15s \
  CMD wget -qO- http://localhost:5677/api/health || exit 1

EXPOSE 5677
WORKDIR /app
ENTRYPOINT ["bongsu-server"]
